<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.1" xmlns="http://xmlns.jcp.org/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_1.xsd">
  <persistence-unit name="MedicinaPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
    <class>Entities.Cliente</class>
    <class>Entities.Tiempos</class>
    <class>Entities.Compras</class>
    <class>Entities.Departamentos</class>
    <class>Entities.Detalleventa</class>
    <class>Entities.Produccion</class>
    <class>Entities.Pedidos</class>
    <class>Entities.Proveedores</class>
    <class>Entities.Ingredientes</class>
    <class>Entities.Productoingredientes</class>
    <class>Entities.Detallepedidos</class>
    <class>Entities.Tiemposmin</class>
    <class>Entities.Ventas</class>
    <class>Entities.Ingredientesprincipales</class>
    <class>Entities.Tiemposmax</class>
    <class>Entities.Detallecompra</class>
    <class>Entities.Facturas</class>
    <class>Entities.Inventarios</class>
    <class>Entities.Observadores</class>
    <class>Entities.Tiempoactividades</class>
    <class>Entities.Productos</class>
    <class>Entities.Empleados</class>
    <properties>
      <property name="javax.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/MedicinaNatural?zeroDateTimeBehavior=convertToNull "/>
      <property name="javax.persistence.jdbc.user" value="root"/>
      <property name="javax.persistence.jdbc.driver" value="com.mysql.jdbc.Driver"/>
      <property name="javax.persistence.jdbc.password" value="rootsito"/>
    </properties>
  </persistence-unit>
</persistence>
